<!-- The root element 'students' must contain one or more 'student' records -->
<!ELEMENT students (student+)>

<!-- Each 'student' node requires an exact sequence of children: name, email, department, semester, and marks -->
<!ELEMENT student (name, email, department, semester, marks)>

<!-- The 'id' attribute must be unique across the document and cannot be omitted -->
<!ATTLIST student id ID #REQUIRED>

<!-- Element textual payload definitions -->
<!ELEMENT name (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT department (#PCDATA)>
<!ELEMENT semester (#PCDATA)>
<!ELEMENT marks (#PCDATA)>
